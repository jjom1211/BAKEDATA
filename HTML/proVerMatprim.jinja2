{# Archivo: templates/ver_materias_primas.jinja2 #}
{% extends "base.jinja2" %}

{% block title %}Inventario de Materias Primas{% endblock %}

{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='proVerMatprim.css') }}">
{% endblock %}

{% block content %}
<div class="container">
    <h2>Inventario de Materias Primas</h2>

    <select id="sucursal">
        <option value="">-- Selecciona una sucursal --</option>
        <option value="1">Paseos del Bosque</option>
        <option value="2">Santuarios</option>
        <option value="3">Pirámides</option>
        <option value="4">Puerta Real</option>
    </select>

    <table id="tablaInventario">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Unidad</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="4" style="text-align: center;">
                    Seleccione una sucursal para ver el inventario
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div id="boton-volver-wrapper">
    <button onclick="window.history.back()" id="botonVolver">
        ⭠ Regresar
    </button>
</div>
{% endblock %}

{% block extra_scripts %}
    <script src="{{ url_for('serve_js', filename='proVerMatprim.js') }}"></script>
{% endblock %}