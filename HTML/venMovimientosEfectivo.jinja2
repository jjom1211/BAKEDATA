{% extends "base.jinja2" %}

{% block title %}Movimientos de Efectivo{% endblock %}

{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='venMovimientosEfectivo.css') }}">
{% endblock %}

{% block content %}
<div class="container">
    <h1>Movimientos de Efectivo</h1>

    <form id="form-movimiento" data-action="{{ url_for('ventas_procesar_movimiento') }}"">
        <label for="fuente_origen">Fuente de Origen:</label>
        <select id="fuente_origen" name="fuente_origen" required>
            <option value="">-- Seleccionar origen --</option>
            <optgroup label="Cajas de la Sucursal">
                {% for caja in cajas_reales %}
                <option value="{{ caja.id }}">{{ caja.nombre }}</option>
                {% endfor %}
            </optgroup>
            <optgroup label="Fuentes Externas">
                {% for fuente in fuentes_externas %}
                <option value="{{ fuente.id }}">{{ fuente.nombre }}</option>
                {% endfor %}
            </optgroup>
        </select>
        
        <label for="fuente_destino">Fuente de Destino:</label>
        <select id="fuente_destino" name="fuente_destino" required>
            <option value="">-- Seleccionar destino --</option>
            <optgroup label="Cajas de la Sucursal">
                {% for caja in cajas_reales %}
                <option value="{{ caja.id }}">{{ caja.nombre }}</option>
                {% endfor %}
            </optgroup>
            <optgroup label="Fuentes Externas">
                {% for fuente in fuentes_externas %}
                <option value="{{ fuente.id }}">{{ fuente.nombre }}</option>
                {% endfor %}
            </optgroup>
        </select>

        <label for="monto">Monto:</label>
        <input type="number" id="monto" name="monto" step="0.1" min="0.50" placeholder="Ej: 100.00" required>
        
        <label for="motivo">Motivo del Movimiento:</label>
        <input type="text" id="motivo" name="motivo" placeholder="Ej: Fondo inicial para turno matutino" required>

        <div class="form-actions">
            <button type="button" class="btn-secondary" onclick="window.history.back()">Regresar</button>
            <button type="submit" class="btn-primary">Confirmar Movimiento</button>
        </div>
    </form>
</div>
{% endblock %}

{% block extra_scripts %}
    <script src="{{ url_for('serve_js', filename='venMovimientosEfectivo.js') }}"></script>
{% endblock %}