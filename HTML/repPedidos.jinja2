{% extends "base.jinja2" %}
{% block title %}Lista de Pedidos{% endblock %}
{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='repPedidos.css') }}">
{% endblock %}
{% block content %}
    <h1>Lista de Pedidos</h1>
    
    <div class="filter-container">
        <form action="{{ url_for('repPedidos') }}" method="get">
            <select name="filtro" id="filtro-select" onchange="this.form.submit()">
                <option value="dia" {% if filtro_actual == 'dia' %}selected{% endif %}>
                    Pedidos del Día
                </option>
                <option value="pendientes" {% if filtro_actual == 'pendientes' %}selected{% endif %}>
                    Pedidos Pendientes
                </option>
            </select>
        </form>
    </div>

    <div class="table-scroll-container">
        <table>
            <thead>
                <tr>
                    <th>#PEDIDO</th>
                    <th>ENTREGA PROGRAMADA</th>
                    <th>MONTO TOTAL</th>
                    <th>SUC. DESTINO</th>
                    <th>ASUNTO</th>
                    <th>DETALLES</th>
                </tr>
            </thead>
            <tbody id="pedidos-table-body">
            {% for pedido in pedidos %}
                <tr>
                    <td>{{ pedido.ped_id }}</td>
                    <td>
                        {% if pedido.ped_fecha_entrega %}
                            {{ pedido.ped_fecha_entrega }} <br>
                            <!-- Aquí usamos la hora ya formateada desde Python -->
                            <small style="color: #402929; font-weight: bold;">
                                {{ pedido.ped_hora_entrega if pedido.ped_hora_entrega else '--:--' }}
                            </small>
                        {% else %}
                            <span style="color: #d9534f; font-weight:bold;">Pendiente</span>
                        {% endif %}
                    </td>
                    <td>${{ "%.2f"|format(pedido.ped_monto_total) }}</td>
                    <td>{{ pedido.sucursal_destino_nombre }}</td> 
                    <td>{{ pedido.ped_asunto }}</td>
                    <td>
                        <button class="btn-detalles" data-id="{{ pedido.ped_id }}">Ver</button>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align: center; padding: 20px;">No hay pedidos registrados.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <button id="backButton" title="Regresar" onclick="window.history.back()">←</button>
    
    <div id="detalle-modal-overlay" class="modal-overlay">
        <div class="modal-content">
            <span class="modal-close-button">&times;</span>
            <h2>Detalles del Pedido</h2>
            <div id="modal-body-content"></div>
        </div>
    </div>
{% endblock %}
{% block extra_scripts %}
    <script src="{{ url_for('serve_js', filename='repPedidos.js') }}"></script>
{% endblock %}