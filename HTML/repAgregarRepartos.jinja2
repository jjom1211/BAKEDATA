{% extends "base.jinja2" %} 
{% block title %}Agregar Nuevos Repartos{% endblock %}
{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='repAgregarRepartos.css') }}">
{% endblock %}
{% block content %}
<div class="container">
    <h2>Agregar Reparto</h2>
    <p>Elige los pedidos que deseas programar para un nuevo reparto.</p>

    {% if pedidos %}
    <table class="table-repartos">
        <thead>
            <tr>
                <th>Seleccionar</th>
                <th>ID Pedido</th>
                <th>Asunto</th>
                <th>Monto Total</th>
                <th>Fecha Pedido</th>
            </tr>
        </thead>
        <tbody>
            {% for pedido in pedidos %}
            <tr>
                <td><input type="checkbox" name="pedidos" value="{{ pedido.ped_id }}"></td>
                <td>{{ pedido.ped_id }}</td>
                <td>{{ pedido.ped_asunto }}</td>
                <td>${{ "%.2f"|format(pedido.ped_monto_total) }}</td>
                <td>{{ pedido.ped_fecha_pedido }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>No hay pedidos pendientes para agregar a un reparto.</p>
    {% endif %}

    <div class="actions">
        <button class="btn-regresar" onclick="goBack()">Regresar</button>
        {% if pedidos %} <button class="btn-crear" onclick="crearRepartos()">Crear Repartos Seleccionados</button>
        {% endif %}
    </div>

</div>
{% endblock %}
{% block extra_scripts %}
    <script src="{{ url_for('serve_js', filename='repAgregarRepartos.js') }}"></script>
{% endblock %}