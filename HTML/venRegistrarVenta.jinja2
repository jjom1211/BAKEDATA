{% extends "base.jinja2" %}

{% block title %}Registrar Venta{% endblock %}

{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='venRegistrarVenta.css') }}">
{% endblock %}

{% block content %}
{# Contenedor principal con el ID de la sucursal #}
<div class="venta-container" data-sucursal-id="{{ sucursal_id }}">
    <h1>Registrar Venta</h1>

    <div class="selector-caja">
        <label for="caja_selector_venta">Selecciona la Caja:</label>
        <select id="caja_selector_venta" required>
            {% if cajas %}
                {% for caja in cajas %}
                    <option value="{{ caja.caja_id }}" {% if loop.first %}selected{% endif %}>
                        Caja {{ caja.caja_id }}
                    </option>
                {% endfor %}
            {% else %}
                <option value="" disabled selected>No hay cajas disponibles</option>
            {% endif %}
        </select>
    </div>
    
    {# Estructura de dos columnas #}
    <div class="venta-grid">
        
        {# Columna Izquierda: Búsqueda y Productos #}
        <div class="productos-columna">
            <h2>Productos Disponibles</h2>
            <input type="text" id="buscador-productos" placeholder="Buscar producto por nombre o ID...">
            <div id="lista-productos" class="lista-items">
                <p>Cargando productos...</p>
            </div>
        </div>

        {# Columna Derecha: Carrito #}
        <div class="carrito-columna">
            <h2>Carrito</h2>
            <div id="lista-carrito" class="lista-items">
                <p>Añade productos desde la lista.</p>
            </div>
            <div class="carrito-total">
                <h3>Total: <span id="carrito-total-monto">$0.00</span></h3>
            </div>
            {# Botón Proceder al Pago (ahora ocupa todo el ancho) #}
            <button id="btn-proceder-pago" class="btn-primary" {% if not cajas %}disabled{% endif %}>Proceder al Pago</button> 
        </div>

    </div> {# Fin de venta-grid #}
</div> {# Fin de venta-container #}

{# --- ESTRUCTURA COMPLETA DEL MODAL DE PAGO (Fuera del container principal) --- #}
<div id="modal-pago" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <span class="modal-close" id="cerrar-modal-pago">&times;</span>
        <h2>Procesar Pago</h2>
        
        {# Selección de Método de Pago #}
        <div class="metodo-pago-selector">
            <label><input type="radio" name="metodo_pago" value="efectivo" checked> Efectivo</label>
            <label><input type="radio" name="metodo_pago" value="tarjeta"> Tarjeta</label>
        </div>
        <hr>

        {# Paso 1: Cobro (visible solo para efectivo) #}
        <div id="paso1-cobro">
            <p><strong>Total a Pagar:</strong> <span id="modal-total-pagar" class="monto-grande">$0.00</span></p>
            <label for="monto-recibido">Monto Recibido:</label>
            <input type="number" id="monto-recibido" step="0.01" min="0" placeholder="Ej: 500.00">
            <p><strong>Cambio a Devolver:</strong> <span id="modal-cambio" class="monto-grande">$0.00</span></p>
            <button id="btn-calcular-cambio" class="btn-secondary">Calcular Cambio y Ver Resumen</button>
        </div>

        {# Paso 2: Mostrar resumen y confirmar #}
        <div id="paso2-resumen" style="display: none;">
            <h4>Resumen de la Venta</h4>
            <div id="modal-resumen-items"><ul><li>Cargando...</li></ul></div>
            <p><strong>Método de Pago:</strong> <span id="resumen-metodo"></span></p>
            <p><strong>Total:</strong> <span id="resumen-total">$0.00</span></p>
            <div id="resumen-efectivo-campos" style="display:none;">
                <p><strong>Recibido:</strong> <span id="resumen-recibido">$0.00</span></p>
                <p><strong>Cambio:</strong> <span id="resumen-cambio">$0.00</span></p>
            </div>
            <button id="btn-confirmar-venta" class="btn-primary">Confirmar Venta</button>
            <button type="button" id="btn-volver-cobro" class="btn-secondary">Volver</button>
        </div>
    </div>
</div>
{# --- FIN DEL MODAL --- #}

{# --- TU BOTÓN DE REGRESAR FIJO --- #}
<button id="botonRegresarFijo" onclick="window.history.back()">⭠</button>
{% endblock %}

{% block extra_scripts %}
    <script src="{{ url_for('serve_js', filename='venRegistrarVenta.js') }}"></script>
{% endblock %}