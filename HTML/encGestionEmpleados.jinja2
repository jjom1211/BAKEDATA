{% extends "base.jinja2" %}

{% block title %}Gestión de Empleados{% endblock %}

{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='encGestionEmpleados.css') }}">
{% endblock %}

{% block content %}
<div class="container">
    <h1>Gestión de Empleados</h1>
    
    <div class="filtro-container">
        <div class="filtro-item">
                        <label for="sucursal_selector">Selecciona una Sucursal:</label>

            <select id="sucursal_selector">
                {# Si es Gerente (G), puede ver todas. Si es Encargado (E), solo la suya #}
                {% if 'G' in session.roles %}
                    <option value="">-- Todas las sucursales --</option>
                    {% for suc in sucursales %}
                        <option value="{{ suc.suc_id }}">{{ suc.suc_nombre }}</option>
                    {% endfor %}
                {% else %}
                    {# Si es Encargado, solo muestra la suya por defecto #}
                    {% for suc in sucursales %}
                        {% if suc.suc_id == sucursal_actual_id %}
                        <option value="{{ suc.suc_id }}" selected>{{ suc.suc_nombre }}</option>
                        {% endif %}
                    {% endfor %}
                {% endif %}
            </select>
        </div>
    </div>

    <div class="tabla-scroll-container">
        <table id="tabla-empleados">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Roles</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="empleados_tbody">
                <tr><td colspan="5">Selecciona una sucursal para ver los empleados.</td></tr>
            </tbody>
        </table>
    </div> </div>
<button id="botonRegresarFijo" onclick="window.history.back()">⭠</button>

<div id="modal-editar-empleado" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <span class="modal-close" data-modal-id="modal-editar-empleado">&times;</span>
        <h2>Editar Empleado</h2>
        <form id="form-editar-empleado">
            <input type="hidden" id="edit-emp-id" name="emp_id">
            
            <label for="edit-nombre">Nombre:</label>
            <input type="text" id="edit-nombre" name="nombre" required>
            
            <label for="edit-apellido">Apellido:</label>
            <input type="text" id="edit-apellido" name="apellido" required>
            
            <label for="edit-correo">Correo:</label>
            <input type="email" id="edit-correo" name="correo" required>
            
            <label for="edit-telefono">Teléfono:</label>
            <input type="text" id="edit-telefono" name="telefono" required>
            <label for="edit-rol-principal">Rol Principal:</label>
            <select id="edit-rol-principal" name="rol_principal" required>
                </select>
            <label>Roles Adicionales:</label>
            <div id="edit-roles-adicionales" class="checkbox-group">
                </div>
            <div class="form-actions">
                <button type="button" class="btn-secondary modal-cancel-btn" data-modal-id="modal-editar-empleado">Cancelar</button>
                <button type="submit" class="btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<div id="modal-password" class="modal-overlay" style="display: none;">
    <div class="modal-content">
        <span class="modal-close" data-modal-id="modal-password">&times;</span>
        <h2>Cambiar Contraseña</h2>
        <form id="form-password">
            <input type="hidden" id="password-emp-id" name="emp_id">
            <p>Establecer una nueva contraseña para el empleado <strong id="password-emp-nombre"></strong>:</p>
            
            <div class="password-container">
                <input type="password" id="nueva-password" name="nueva_password" required>
                <span class="toggle-password" onclick="togglePassword('nueva-password')">👁‍🗨</span>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn-secondary modal-cancel-btn" data-modal-id="modal-password">Cancelar</button>
                <button type="submit" class="btn-primary">Establecer Contraseña</button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block extra_scripts %}
    <script src="{{ url_for('serve_js', filename='encGestionEmpleados.js') }}"></script>
{% endblock %}