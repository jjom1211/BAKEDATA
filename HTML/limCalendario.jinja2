<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendario de la Panadería</title>
    <link rel="icon" href="https://i.imgur.com/WW384uk.png" type="image/png" sizes="16x16">
    <link rel="stylesheet" href="../CSS/limCalendario.css">
</head>
<body>
            <!-- Botón para abrir/cerrar la sidebar -->
            <button class="open-sidebar" onclick="toggleSidebar()">☰</button>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Imagen de fondo -->
                <div class="sidebar-background"></div>
                <!-- Contenido de la sidebar -->
                <div class="sidebar-content">
                    <img src="https://i.imgur.com/WW384uk.png" alt="Gerencia" class="sidebar-logo" sizes="16x16">
                    <button class="button admin-only" onclick="window.location.href='almacen.html'">Almacén</button>
                    <button class="button admin-only" onclick="window.location.href='reparto.html'">Reparto</button>
                    <button class="button admin-only" onclick="window.location.href='usuario.html'">Usuario</button>
                    <button class="button admin-only" onclick="window.location.href='produccion.html'">Producción</button>
                    <button class="button admin-only" onclick="window.location.href='ventas.html'">Ventas</button>
                    <button class="button admin-only" onclick="window.location.href='limpieza.html'">Limpieza</button>
                    <button class="button admin-only" onclick="window.location.href='reportes.html'">Reportes</button>
                    <button class="button admin-only" onclick="window.location.href='gerente.html'"> Gerente</button>
                    <button class="button return-login" onclick="window.location.href='login.html'">
                    <img src="https://i.imgur.com/ft5fWsY.png"  alt="Regresar al Inicio" class="return-icon">
                </div>
            </div>
    <h1>Calendario de limpiezas</h1>
    <div class="calendar">
        <div class="header">
            <button id="prevMonth">&lt;</button>
            <h2 id="currentMonth"></h2>
            <button id="nextMonth">&gt;</button>
        </div>
        <div class="days">
            <div class="day">Dom</div>
            <div class="day">Lun</div>
            <div class="day">Mar</div>
            <div class="day">Mié</div>
            <div class="day">Jue</div>
            <div class="day">Vie</div>
            <div class="day">Sáb</div>
        </div>
        <div id="calendarGrid" class="grid"></div>
    </div>
    <div class="buttons">
        <button id="backButton">Regresar</button>
        <button id="confirmButton">Confirmar limpieza</button>
    </div>
    <div id="tareasDelDia" class="tareas-del-dia"></div>
    <script>
        const diasConLimpieza = {{ dias_limpieza | tojson | safe }};
    </script>
    
    <script src="../JS/limCalendario.js"></script>
</body>
</html>