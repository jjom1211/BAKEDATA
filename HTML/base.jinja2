<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %}</title>
    <link rel="icon" href="https://i.imgur.com/WW384uk.png" type="image/png" sizes="16x16">
    
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='gen.css') }}">
    
    {% block head_links %}{% endblock %}
</head>
<body>
    <button class="open-sidebar" onclick="toggleSidebar()">☰</button>
    
    <div class="sidebar">
        <div class="sidebar-background"></div>
        <div class="sidebar-content">
            <img src="https://i.imgur.com/WW384uk.png" alt="Logo" class="sidebar-logo">
        </div>
    </div>
    
    <div class="content">
        {% block content %}{% endblock %}
    </div>

    <script src="{{ url_for('serve_js', filename='sidebar.js') }}"></script>
    
    {% block extra_scripts %}{% endblock %}
</body>
</html>