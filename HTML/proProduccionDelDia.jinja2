{% extends "base.jinja2" %}

{% block title %}Producción de Hoy{% endblock %}

{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='proProduccionDelDia.css') }}">
{% endblock %}

{% block content %}
<div class="container">
    <h1>Producción de Hoy</h1>

    {# --- SECCIÓN SOLO PARA GERENTES --- #}
    {% if es_gerente %}
    <div class="admin-selector-container">
        <label for="sucursal_admin"><strong>Ver Producción de:</strong></label>
        <select id="sucursal_admin">
            {% for suc in sucursales %}
                <option value="{{ suc.suc_id }}" {% if suc.suc_id == sucursal_propia %}selected{% endif %}>
                    {{ suc.suc_nombre }}
                </option>
            {% endfor %}
        </select>
    </div>
    {% endif %}
    {# -------------------------------- #}

    <div id="tabla-wrapper" data-sucursal-propia="{{ sucursal_propia }}">
        <table id="tablaProduccion">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cantidad</th>
                    <th>Realizado</th>
                </tr>
            </thead>
            <tbody>
                </tbody>
        </table>
    </div>
    
    <button class="button" onclick="confirmarProduccion()" id="btnConfirmar">
        Confirmar Productos Realizados
    </button>
    <button id="botonRegresarFijo" onclick="window.history.back()">⭠</button>
</div>
{% endblock %}

{% block extra_scripts %}
    <script src="{{ url_for('serve_js', filename='proProduccionDelDia.js') }}"></script>
{% endblock %}