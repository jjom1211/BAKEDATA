{% extends "base.jinja2" %}

{% block title %}Crear Cuenta de Empleado{% endblock %}

{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='encCrearCuentaEmpleado.css') }}">
{% endblock %}

{% block content %}
<div class="container">
    <h1>Crear Cuenta de Empleado</h1>
    
    <div class="content-box">
        {# Muestra mensajes de éxito o error #}
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                    <div class="alert alert-{{ category }}">{{ message }}</div>
                {% endfor %}
            {% endif %}
        {% endwith %}

        <form method="POST" action="{{ url_for('crear_empleado') }}" onsubmit="return validarFormulario(event)">
            
            <label for="nombre">Nombre(s):</label>
            <input type="text" id="nombre" name="nombre" required>
            
            <label for="apellido">Apellido(s):</label>
            <input type="text" id="apellido" name="apellido" required>

            <label for="correo">Correo:</label>
            <input type="email" id="correo" name="correo" required>

            <label for="telefono">Teléfono:</label>
            <input type="text" id="telefono" name="telefono" required>

            <label for="sucursal">Sucursal Asignada:</label>
            <select id="sucursal" name="sucursal" required>
                <option value="">-- Seleccionar sucursal --</option>
                {% for suc in sucursales %}
                <option value="{{ suc.suc_id }}">{{ suc.suc_nombre }}</option>
                {% endfor %}
            </select>

            <label for="rol_principal">Rol Principal:</label>
            <select id="rol_principal" name="rol_principal" required>
                <option value="">-- Seleccionar rol --</option>
                {% for rol in roles %}
                <option value="{{ rol.id }}">{{ rol.nombre }}</option>
                {% endfor %}
            </select>

            <div class="password-container">
                <label for="contraseña">Contraseña:</label>
                <input type="password" id="contraseña" name="contraseña" required>
                <span class="toggle-password" onclick="togglePassword('contraseña')">👁‍🗨</span>
            </div>

            <div class="password-container">
                <label for="confirmacion_de_contraseña">Confirmación de contraseña:</label>
                <input type="password" id="confirmacion_de_contraseña" name="confirmacion_de_contraseña" required>
                <span class="toggle-password" onclick="togglePassword('confirmacion_de_contraseña')">👁‍🗨</span>
            </div>

            <div class="form-actions">
                <button type="button" class="btn-secondary" onclick="window.location.href='{{ url_for('encargado') }}'">Regresar</button>
                <button type="submit" class="btn-primary">Crear Empleado</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
    <script src="{{ url_for('serve_js', filename='encCrearCuentaEmpleado.js') }}"></script>
{% endblock %}