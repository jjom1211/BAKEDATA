{% extends "base.jinja2" %}

{% block title %}Solicitar Productos{% endblock %}

{% block head_links %}
    <link rel="stylesheet" href="{{ url_for('serve_css', filename='venSolicitarProductos.css') }}">
{% endblock %}

{% block content %}
<div class="venta-container">
    <h1>Solicitar Productos</h1>
    <p>Selecciona los productos y programa su entrega.</p>
    
    <div class="venta-grid">
        <!-- COLUMNA IZQUIERDA: PRODUCTOS -->
        <div class="productos-columna">
            <h2>Productos Disponibles</h2>
            <input type="text" id="buscador-productos" placeholder="Buscar por nombre o ID...">
            <div id="lista-productos" class="lista-items">
                <!-- Se llena con JS -->
            </div>
        </div>
        
        <!-- COLUMNA DERECHA: CARRITO Y DATOS -->
        <div class="carrito-columna">
            <h2>Mi Solicitud</h2>
            
            <div id="lista-carrito" class="lista-items">
                <p class="empty-msg">Añade productos desde la lista.</p>
            </div>
            
            <div class="form-section">
                <!-- Selector de Origen -->
                <div class="control-group">
                    <label for="sucursal-origen">Solicitar desde (Origen):</label>
                    <select id="sucursal-origen" required>
                        <option value="">-- Seleccionar --</option>
                        {% for suc in sucursales %}
                            <option value="{{ suc.suc_id }}" {% if suc.suc_id == 1 %}selected{% endif %}>
                                {{ suc.suc_nombre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- NUEVO: Fecha y Hora -->
                <div class="datetime-container">
                    <div class="form-group-half">
                        <label for="fecha-entrega">Fecha Requerida:</label>
                        <input type="date" id="fecha-entrega">
                    </div>
                    <div class="form-group-half">
                        <label for="hora-entrega">Hora:</label>
                        <input type="time" id="hora-entrega">
                    </div>
                </div>

                <!-- Comentarios -->
                <div class="control-group">
                    <label for="comentarios-solicitud">Comentarios:</label>
                    <textarea id="comentarios-solicitud" placeholder="Instrucciones especiales..."></textarea>
                </div>
            </div>

            <div class="carrito-total">
                <h3>Costo Estimado: <span id="carrito-total-monto">$0.00</span></h3>
            </div>
            
            <button id="btn-confirmar-solicitud" class="btn-primary" disabled>
                Finalizar Solicitud
            </button>
        </div>
    </div>
</div>
<button id="botonRegresarFijo" onclick="window.history.back()">⭠</button>
{% endblock %}

{% block extra_scripts %}
    <script>
        const TODOS_LOS_PRODUCTOS = {{ productos | tojson | safe }};
    </script>
    <script src="{{ url_for('serve_js', filename='venSolicitarProductos.js') }}"></script>
{% endblock %}